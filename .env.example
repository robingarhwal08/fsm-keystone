# .env.example — copy to .env and fill in real values.
# .env is git-ignored; .env.example is tracked.
# See docs/baseline/required-properties.md for the full manifest.
# See docs/runbooks/secret-rotation.md for how to generate each value.

# ─── REQUIRED — no safe default. Application will not start without these. ───

# JWT signing key: generate with: openssl rand -hex 32
APP_JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Database password (must match POSTGRES_PASSWORD below)
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# ─── Required per environment ────────────────────────────────────────────────

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fsmdb
SPRING_DATASOURCE_USERNAME=postgres

# PostgreSQL container password (must match SPRING_DATASOURCE_PASSWORD above)
POSTGRES_PASSWORD=<your-database-password>

# Frontend CORS origin (change per environment)
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000

# ─── Optional — safe defaults exist but should be explicit in non-dev ────────

SPRING_APPLICATION_NAME=keystone
PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
APP_JWT_EXPIRATION_MS=900000
