# .env.example — copy to .env and fill in real values.
# .env is git-ignored; .env.example is tracked (no real secrets here).
#
# Quick start:
#   bash scripts/dev/bootstrap-secrets.sh
#   docker compose up
#
# See docs/baseline/required-properties.md for the full manifest.
# See docs/runbooks/secret-rotation.md for how to generate each value.

# ─── PostgreSQL container ─────────────────────────────────────────────────────

POSTGRES_DB=fsmdb
POSTGRES_USER=postgres
# Required — no default. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=<your-database-password>

# ─── Spring datasource ───────────────────────────────────────────────────────

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fsmdb
SPRING_DATASOURCE_USERNAME=postgres
# Must match POSTGRES_PASSWORD above.
# In Docker Compose the file-based secret /run/secrets/spring.datasource.password
# takes precedence — set this for env-var-only environments (CI, plain Java).
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Required — 64-character hex signing key. Generate with: openssl rand -hex 32
# In Docker Compose the file-based secret /run/secrets/app.jwt.secret takes
# precedence — set this for env-var-only environments (CI, plain Java).
APP_JWT_SECRET=<generate-with-openssl-rand-hex-32>
APP_JWT_EXPIRATION_MS=86400000

# ─── CORS / Frontend ─────────────────────────────────────────────────────────

APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080

# ─── Optional — safe defaults exist ─────────────────────────────────────────

SPRING_APPLICATION_NAME=keystone
PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
